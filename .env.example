# Copy to .env and edit. Paths use forward slashes on Windows.
# Folder to scan (mounted read-write at /videos inside the container).
VIDEO_DIR=./videos
# Windows example: VIDEO_DIR=D:/Videos

# Folder for moved duplicates (mounted at /output). Duplicates go to OUTPUT_DIR/duplicates/...
OUTPUT_DIR=./output
# Windows example: OUTPUT_DIR=D:/Videos-duplicates
