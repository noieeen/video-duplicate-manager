{
  "name": "video-duplicate-manager-app",
  "productName": "Video Duplicate Manager",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop UI for the Video Duplicate Manager engine",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "dist": "npm run build && electron-builder --win",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "com.noieeen.videodupmanager",
    "productName": "Video Duplicate Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "extraResources": [
      {
        "from": "../dist-engine/engine",
        "to": "engine"
      },
      {
        "from": "../vendor/ffmpeg",
        "to": "ffmpeg"
      }
    ]
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-electron": "^1.2.0"
  }
}
